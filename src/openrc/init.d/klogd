#!/sbin/openrc-run
# Copyright (c) 2025 Kimigayo OS
# Distributed under the terms of the MIT License
# ビルドでは使われていない。イメージに入る init スクリプトと conf.d は
# OpenRC 上流のもの（scripts/build-openrc.sh）で、このファイルは
# scripts/test-openrc-integration.sh が存在を確かめるだけ。

name="Kernel Logger"
description="BusyBox klogd kernel logging service"

command="/sbin/klogd"
command_args="${KLOGD_OPTS:--n}"
command_background=true
pidfile="/var/run/klogd.pid"

depend() {
    need syslog
    use clock
    provide kernel-logger
}
