#!/sbin/openrc-run
# Copyright (c) 2025 Kimigayo OS
# Distributed under the terms of the MIT License
# ビルドでは使われていない。イメージに入る init スクリプトと conf.d は
# OpenRC 上流のもの（scripts/build-openrc.sh）で、このファイルは
# scripts/test-openrc-integration.sh が存在を確かめるだけ。

name="System Logger"
description="BusyBox syslogd system logging service"

command="/sbin/syslogd"
command_args="${SYSLOGD_OPTS:--n -O /var/log/messages}"
command_background=true
pidfile="/var/run/syslogd.pid"

depend() {
    need localmount
    use clock
    before net
    provide logger
}

start_pre() {
    # Create log directory if it doesn't exist
    checkpath --directory --mode 0755 /var/log
}
