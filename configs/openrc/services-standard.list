# Kimigayo OS - Standard Service Configuration
# 標準的なコンテナ環境向けサービスリスト
# ビルドでは使われていない（どこからも読まれていない）。イメージの
# /etc/runlevels とも一致しない（mdev・urandom・syslog・networking・crond はイメージに無い）。

# === sysinit ランレベル ===
devfs
dmesg
mdev

# === boot ランレベル ===
bootmisc
hostname
hwclock
loopback
modules
networking
swap
sysctl
syslog
urandom

# === default ランレベル ===
crond
local

# === shutdown ランレベル ===
killprocs
mount-ro
savecache
