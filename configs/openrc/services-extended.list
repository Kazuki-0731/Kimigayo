# Kimigayo OS - Extended Service Configuration
# フル機能コンテナ環境向けサービスリスト
# ビルドでは使われていない（どこからも読まれていない）。イメージの
# /etc/runlevels とも一致しない（mdev・udev・urandom・syslog・networking・crond・dbus・iptables・sshd はイメージに無い）。

# === sysinit ランレベル ===
devfs
dmesg
mdev
udev

# === boot ランレベル ===
bootmisc
fsck
hostname
hwclock
loopback
modules
networking
procfs
root
swap
sysctl
syslog
urandom

# === default ランレベル ===
crond
dbus
iptables
local
sshd

# === shutdown ランレベル ===
killprocs
mount-ro
savecache
