# Kimigayo OS ビルド設定
# このファイルを .env にコピーして使用してください
# cp .env.example .env
#
# 効くのはホスト側の Makefile のターゲット（ci-build-local / build-image /
# push-image など）だけ。コンテナ内の make build は読まない
# （docker-compose.yml が ARCH=x86_64 を固定し、TARGET_ARCH / IMAGE_TYPE は
# コマンドラインで渡す）。
# 上書きはコマンドライン引数で行う（make ci-build-local VARIANT=minimal）。
# 環境変数（VARIANT=minimal make ...）は .env に負ける。

# アーキテクチャ (x86_64 または arm64)
ARCH=x86_64

# イメージバリアント (minimal, standard, extended)
VARIANT=standard

# バージョン
VERSION=latest

# Docker Hub設定
DOCKER_HUB_USERNAME=ishinokazuki
IMAGE_NAME=kimigayo-os

# Docker Hub アクセストークン
# ⚠️ 重要: このトークンは機密情報です。.envファイルは絶対にコミットしないでください
# Docker Hubでトークンを生成: https://hub.docker.com/settings/security
# ローカルビルドでDocker Hubにプッシュする場合のみ必要
# 例: DOCKER_HUB_ACCESS_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx
DOCKER_HUB_ACCESS_TOKEN=

