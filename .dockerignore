# Git
.git
.gitignore

# Claude
.claude

# Secrets (Docker Hub token). Never send to the daemon.
.env

# Test / benchmark caches
.pytest_cache/
benchmark-results/

# Build artifacts
build/
# output/ は rootfs の tarball だけ残す。Dockerfile.runtime が
# COPY ${TARBALL_PATH}（既定 output/*.tar.gz）で使うため。
# それ以外（ログや一時ファイル）は送らない。
output/*
!output/*.tar.gz
*.o
*.a
*.so
*.img
*.iso

# Editor files
*.swp
*.swo
*~
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
!SPECIFICATION.md
!README.md
